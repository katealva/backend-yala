# ==========================================
# Yala backend — Variables de entorno
# Copiar este archivo a .env y completar con valores reales.
# El archivo .env está en .gitignore y nunca se commitea.
# ==========================================

# ----- Server -----
PORT_NUMBER=8081

# ----- PostgreSQL (Docker local: docker-compose up) -----
DB_HOST=localhost
DB_PORT=5433
DB_NAME=yala
DB_USER=postgres
DB_PASSWORD=postgres

# ----- JWT — generar secreto >= 32 caracteres para HS256 -----
JWT_SECRET=replace-me-with-a-real-secret-min-256-bits-long-please
jwt.expiration-access=3600000
jwt.expiration-refresh=604800000

# ----- AWS S3 (imágenes) -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=yala-bucket-dev

# ----- Mercado Pago (pagos) -----
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ----- Resend (emails) -----
RESEND_API_KEY=
RESEND_FROM=noreply@yala.pe

# ----- App -----
APP_BASE_URL=http://localhost:8081
