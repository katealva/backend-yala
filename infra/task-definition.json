{
  "family": "yala-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/yala-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/yala-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "app",
      "image": "__IMAGE_URI__",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8081,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "PORT_NUMBER", "value": "8081" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        { "name": "DB_HOST",                 "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/db-host" },
        { "name": "DB_PORT",                 "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/db-port" },
        { "name": "DB_NAME",                 "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/db-name" },
        { "name": "DB_USER",                 "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/db-user" },
        { "name": "DB_PASSWORD",             "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/db-password" },
        { "name": "JWT_SECRET",              "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/jwt-secret" },
        { "name": "AWS_S3_BUCKET",           "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/aws-s3-bucket" },
        { "name": "MERCADOPAGO_ACCESS_TOKEN","valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/mp-access-token" },
        { "name": "MERCADOPAGO_PUBLIC_KEY",  "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/mp-public-key" },
        { "name": "RESEND_API_KEY",          "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/resend-api-key" },
        { "name": "RESEND_FROM",             "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/resend-from" },
        { "name": "APP_BASE_URL",            "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/app-base-url" },
        { "name": "APP_WEB_URL",             "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/app-web-url" },
        { "name": "LIVEKIT_URL",             "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/livekit-url" },
        { "name": "LIVEKIT_API_KEY",         "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/livekit-api-key" },
        { "name": "LIVEKIT_API_SECRET",      "valueFrom": "arn:aws:ssm:us-east-1:__ACCOUNT_ID__:parameter/yala/prod/livekit-api-secret" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/yala-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
